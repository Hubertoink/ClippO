{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClippO",
  "version": "0.5.1",
  "identifier": "io.clippo.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ClippO",
        "width": 420,
        "height": 260,
        "visible": false,
        "focus": false,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true,
        "windowEffects": { "effects": ["acrylic"], "color": "#272633ce" }
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost 'self'; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": ["resources/engines/**/*", "resources/licenses/*"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "skip" },
      "nsis": { "installMode": "currentUser" }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlGNUVERjgwRkQyNDg1RDAKUldUUWhTVDlnTjllbjdkNGlJZWoyZUdONzFQQ0h3Qm9USW1XSjJEd3lTS0M2WjIxbDV1dDVpNXAK",
      "endpoints": [
        "https://github.com/Hubertoink/ClippO/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
