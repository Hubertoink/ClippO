# Build from this checkout with "makepkg -si" in packaging/arch.
pkgname=clippo
pkgver=0.9.0
pkgrel=1
pkgdesc='Floating desktop widget for local image, PDF and audio compression'
arch=('x86_64')
url='https://github.com/Hubertoink/ClippO'
license=('MIT')
depends=('webkit2gtk-4.1' 'libappindicator-gtk3' 'xdotool' 'imagemagick' 'qpdf' 'ghostscript')
makedepends=('cargo' 'nodejs' 'npm' 'nasm' 'cmake')
options=('!lto' '!debug')

prepare() {
  local repo="$startdir/../.."
  mkdir -p "$srcdir/clippo/src-tauri/resources"
  cp -r "$repo"/{src,public,index.html,package*.json,tsconfig.json,vite.config.ts,LICENSE} "$srcdir/clippo/"
  cp -r "$repo"/src-tauri/{src,icons,capabilities,Cargo.*,build.rs,tauri*.json} "$srcdir/clippo/src-tauri/"
  cp -r "$repo/src-tauri/resources/licenses" "$srcdir/clippo/src-tauri/resources/"
}

build() {
  cd "$srcdir/clippo"
  npm ci
  VITE_CLIPPO_PACKAGER=pacman npm run tauri -- build --no-bundle -- --locked
}

package() {
  cd "$srcdir/clippo"
  install -Dm755 src-tauri/target/release/clippo "$pkgdir/usr/bin/clippo"
  install -Dm644 src-tauri/icons/icon.png "$pkgdir/usr/share/pixmaps/clippo.png"
  install -Dm644 "$startdir/clippo.desktop" "$pkgdir/usr/share/applications/clippo.desktop"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/clippo/LICENSE"
  install -m644 src-tauri/resources/licenses/* "$pkgdir/usr/share/licenses/clippo/"
}
